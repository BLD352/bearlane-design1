generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MANAGER
  PRODUCTION_OPERATOR
  DESIGNER
  CUSTOMER
}

enum ProjectStatus {
  DRAFT
  PROOF_SENT
  REVISION_REQUESTED
  APPROVED
  PRODUCTION
  QC
  COMPLETED
  ARCHIVED
}

enum ProductionStage {
  READY
  RUNNING
  QC
  COMPLETED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FileKind {
  EMBROIDERY
  ARTWORK
  PROOF
  REFERENCE
  LOGO
}

model User {
  id            String   @id @default(cuid())
  clerkId       String   @unique
  email         String   @unique
  name          String?
  role          Role     @default(CUSTOMER)
  imageUrl      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  assignedJobs  ProductionJob[] @relation("OperatorJobs")
  approvals     Approval[]      @relation("ApprovalReviewer")
  activityLogs  ActivityLog[]
}

model Customer {
  id                    String   @id @default(cuid())
  name                  String
  company               String?
  phone                 String?
  email                 String   @unique
  notes                 String?
  preferredGarmentTypes String[] @default([])
  preferredThreadColors String[] @default([])
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  projects      Project[]
  orders        Order[]
  files         FileAsset[]
  approvals     Approval[]
  activityLogs  ActivityLog[]

  @@index([name])
  @@index([company])
}

model Project {
  id              String        @id @default(cuid())
  customerId      String
  title           String
  description     String?
  status          ProjectStatus @default(DRAFT)
  deadline        DateTime?
  orderQuantity   Int           @default(1)
  priority        Int           @default(2)
  workflowStage   ProductionStage @default(READY)
  productionNotes String?
  proofToken      String?       @unique
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  customer        Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orders          Order[]
  files           FileAsset[]
  approvals       Approval[]
  productionJobs  ProductionJob[]
  notes           ProductionNote[]
  activityLogs    ActivityLog[]

  @@index([status])
  @@index([deadline])
  @@index([workflowStage])
}

model Order {
  id          String   @id @default(cuid())
  customerId  String
  projectId   String?
  orderNumber String   @unique
  quantity    Int      @default(1)
  repeatOfId  String?
  garmentType String?
  dueDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  repeatOf    Order?   @relation("RepeatOrders", fields: [repeatOfId], references: [id], onDelete: SetNull)
  repeats     Order[]  @relation("RepeatOrders")
}

model FileAsset {
  id             String   @id @default(cuid())
  customerId     String?
  projectId      String?
  currentVersionId String? @unique
  kind           FileKind
  name           String
  extension      String
  mimeType       String?
  r2Key          String
  previewKey     String?
  sizeBytes      Int
  stitchCount    Int?
  widthMm        Float?
  heightMm       Float?
  threadColors   String[] @default([])
  garmentNotes   String?
  isFavorite     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  customer       Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  project        Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  currentVersion FileVersion?  @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions       FileVersion[] @relation("FileVersions")
  tags           FileTag[]
  approvals      Approval[]

  @@index([kind])
  @@index([extension])
  @@index([stitchCount])
}

model FileVersion {
  id          String   @id @default(cuid())
  fileId      String
  version     Int
  r2Key       String
  sizeBytes   Int
  checksum    String?
  notes       String?
  createdAt   DateTime @default(now())

  file        FileAsset @relation("FileVersions", fields: [fileId], references: [id], onDelete: Cascade)
  currentFor  FileAsset? @relation("CurrentVersion")

  @@unique([fileId, version])
}

model Approval {
  id           String         @id @default(cuid())
  customerId   String
  projectId    String
  fileId       String?
  reviewerId   String?
  token        String         @unique
  status       ApprovalStatus @default(PENDING)
  comment      String?
  referenceUrl String?
  expiresAt    DateTime?
  respondedAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  customer     Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  file         FileAsset?     @relation(fields: [fileId], references: [id], onDelete: SetNull)
  reviewer     User?          @relation("ApprovalReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([status])
}

model MachineSetting {
  id              String   @id @default(cuid())
  name            String
  machineName     String
  hoopNotes       String?
  needleSettings  Json?
  defaultThreads  String[] @default([])
  estimatedSpm    Int      @default(650)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  productionJobs  ProductionJob[]
}

model ProductionJob {
  id                    String          @id @default(cuid())
  projectId             String
  machineSettingId      String?
  operatorId            String?
  stage                 ProductionStage @default(READY)
  machineName           String?
  hoopNotes             String?
  threadColors          String[]        @default([])
  needleSettings        Json?
  runQuantity           Int             @default(1)
  estimatedMinutes      Int             @default(30)
  sortOrder             Int             @default(0)
  startedAt             DateTime?
  completedAt           DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  project               Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  machineSetting        MachineSetting? @relation(fields: [machineSettingId], references: [id], onDelete: SetNull)
  operator              User?           @relation("OperatorJobs", fields: [operatorId], references: [id], onDelete: SetNull)

  @@index([stage, sortOrder])
}

model ProductionNote {
  id          String   @id @default(cuid())
  projectId   String
  body        String
  isPinned    Boolean  @default(false)
  createdAt   DateTime @default(now())

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id          String   @id @default(cuid())
  actorId     String?
  customerId  String?
  projectId   String?
  action      String
  metadata    Json?
  createdAt   DateTime @default(now())

  actor       User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([createdAt])
}

model Tag {
  id        String    @id @default(cuid())
  name      String    @unique
  color     String    @default("#991b1b")
  files     FileTag[]
}

model FileTag {
  fileId String
  tagId  String
  file   FileAsset @relation(fields: [fileId], references: [id], onDelete: Cascade)
  tag    Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([fileId, tagId])
}
